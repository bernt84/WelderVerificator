const PROMPT=`You are reading a welder qualification certificate (ISO 9606-1 or similar, possibly issued under class rules such as DNV, BV, LR, ABS). Read all pages. Return ONLY a JSON object, no other text, with exactly these keys:
{"issuer":string|null,"issuerEmail":string|null,"certNo":string|null,"fileNo":string|null,"name":string|null,"employer":string|null,"dob":"YYYY-MM-DD"|null,"idNo":string|null,"standard":string|null,"designation":string|null,"testDate":"YYYY-MM-DD"|null,"issueDate":"YYYY-MM-DD"|null,"method":"a"|"b"|"c"|null,"validTo":"YYYY-MM-DD"|null,"examiner":string|null,"restrictions":string|null,"verifyUrl":string|null,
"confirmations":[{"date":"YYYY-MM-DD"|null,"name":string|null,"title":string|null}],
"revalidations":[{"date":"YYYY-MM-DD"|null,"validUntil":"YYYY-MM-DD"|null,"body":string|null}],
"anomalies":[string]}
Rules:
- testDate is the test date or "validity begins from" date. issueDate is the date next to the examiner's signature.
- method is the ISO 9606-1 clause 9.3 revalidation method used (a = retest every 3 years, b = verification every 2 years, c = continuous). If "valid until" refers to 9.3a use "a". null if unclear.
- confirmations: every row in the employer/supervisor 6-month confirmation table (clause 9.2) that contains a date, name or signature, in the order written. Use null for parts you cannot read. Do not include empty rows.
- revalidations: filled rows in the examiner/examining body revalidation tables.
- restrictions: any limitation of use written on the certificate, e.g. "for shipbuilding, offshore and marine equipment only".
- anomalies: short English descriptions of visual signs that the document may have been altered: a field in a different font, size or weight than similar fields, text not aligned with the form, remains of erased text, white patches, stamps or signatures that look pasted, identical-looking 6-month signatures. Empty list if nothing is visible. Do not speculate.
- Dates must be YYYY-MM-DD. Never guess values that are not written on the certificate.`;
const AIQ=[];let aiRunning=0;
function aiQueue(id){const it=ITEMS.find(x=>x.id===id);if(!it)return;if(!SET.key){toast('Indtast en API-nøgle under Indstillinger for at bruge AI-aflæsning.');$('btnSettings').click();return}
  it.ai.status='queued';it.ai.error='';renderHead(it);if(!AIQ.includes(id))AIQ.push(id);aiPump()}
function aiPump(){while(aiRunning<2&&AIQ.length){const id=AIQ.shift();aiRunning++;aiRead(id).finally(()=>{aiRunning--;aiPump()})}}
async function aiRead(id){
  const it=ITEMS.find(x=>x.id===id);if(!it)return;it.ai.status='running';renderHead(it);
  try{
    const d=await getDoc(id);const content=[];
    for(let p=1;p<=Math.min(d.n,6);p++){const c=await renderPage(id,p,1400);content.push({type:'image',source:{type:'base64',media_type:'image/jpeg',data:c.toDataURL('image/jpeg',.85).split(',')[1]}})}
    content.push({type:'text',text:PROMPT});
    const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'content-type':'application/json','x-api-key':SET.key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},body:JSON.stringify({model:SET.model,max_tokens:4000,messages:[{role:'user',content}]})});
    const data=await r.json();
    if(!r.ok)throw new Error(data&&data.error&&data.error.message||('HTTP '+r.status));
    const txt=(data.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('\n');
    const j=JSON.parse(txt.replace(/```json|```/g,'').trim().replace(/^[^{]*/,'').replace(/[^}]*$/,''));
    FIELDS.forEach(([k,,t])=>{const v=j[k];if(v==null||v==='')return;if(it.f[k])return;it.f[k]=t==='date'?normDate(v):String(v)});
    if(j.method&&!it.f.method&&/^[abc]$/.test(j.method))it.f.method=j.method;
    if(Array.isArray(j.confirmations)&&!it.conf.length)it.conf=j.confirmations.map(c=>({date:normDate(c.date),name:c.name||'',title:c.title||'',ai:true}));
    if(Array.isArray(j.revalidations)&&!it.reval.length)it.reval=j.revalidations.map(c=>({date:normDate(c.date),validUntil:normDate(c.validUntil),body:c.body||'',ai:true}));
    it.ai={status:'done',anomalies:Array.isArray(j.anomalies)?j.anomalies.filter(Boolean):[],error:'',at:new Date().toISOString()};
  }catch(e){console.error(e);it.ai.status='error';it.ai.error=String(e.message||e)}
  save(it);renderList();
}
