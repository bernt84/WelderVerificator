/* ================= vurdering ================= */
function crossAlerts(it){
  const A=[];const cn=norm(it.f.certNo);
  ITEMS.forEach(o=>{
    if(o===it)return;
    const same=cn&&cn===norm(o.f.certNo);
    const r=it.cmp[o.id];
    if(!same&&!r)return;
    const lab=`${o.file.name}`;
    if(same){
      const diffs=[['name','navn','name'],['employer','arbejdsgiver','employer'],['dob','fødselsdato','date of birth'],['validTo','gyldig til','valid until'],['issuer','udsteder','issuer'],['testDate','prøvedato','test date']]
        .filter(([k])=>it.f[k]&&o.f[k]&&norm(it.f[k])!==norm(o.f[k]));
      if(diffs.length)A.push({lvl:'bad',fraud:true,t:`Samme certifikat-nr. findes i ${lab} med andre oplysninger: ${diffs.map(([k,l])=>`${l} "${o.f[k]}" mod "${it.f[k]}"`).join('; ')}.`,en:`The same certificate number exists in ${lab} with different data: ${diffs.map(([k,,l])=>`${l} "${o.f[k]}" versus "${it.f[k]}"`).join('; ')}.`});
      else A.push({lvl:'warn',t:`Samme certifikat-nr. findes også i ${lab}.`,en:`The same certificate number also exists in ${lab}.`});
    }
    if(r&&r.clusters>0)A.push({lvl:'bad',fraud:true,t:`Billedsammenligning med ${lab}: ${r.clusters} ${r.clusters===1?'område afviger':'områder afviger'} (se udsnit).`,en:`Image comparison with ${lab}: ${r.clusters} area${r.clusters===1?'':'s'} differ (see extract).`,crops:r.crops});
    else if(r&&r.clusters===0)A.push({lvl:'ok',t:`Billedsammenligning med ${lab}: ingen tydelige forskelle.`,en:`Image comparison with ${lab}: no visible differences.`});
  });
  return A;
}
function evaluate(it){
  const A=[],f=it.f,now=D(today());
  const start=D(f.testDate),iss=D(f.issueDate),to=D(f.validTo);
  // gyldighedsslut incl. revalidering
  let end=to;it.reval.forEach(r=>{const v=D(r.validUntil);if(v&&(!end||v>end))end=v});
  // 6-måneders kæde
  const events=[...it.conf.map(c=>({d:D(c.date),k:'c'})),...it.reval.map(r=>({d:D(r.date),k:'r'}))].filter(e=>e.d&&(!start||e.d>=start)).sort((a,b)=>a.d-b.d);
  const unread=it.conf.filter(c=>!D(c.date)).length;
  let prev=start,gaps=[],nextDue=null,lapsed=null;
  if(start){for(const e of events){const due=addM(prev,6);if(e.d>due){gaps.push({from:prev,due,to:e.d});if(!lapsed)lapsed=due}if(e.d>prev)prev=e.d}nextDue=addM(prev,6)}
  const sig={start,events,nextDue,gaps,lapsed,end,unread,last:events.length?events[events.length-1].d:null};
  let blocking=false;
  if(!start){A.push({lvl:'warn',t:'Prøvedato / gyldig fra mangler, så gyldigheden kan ikke vurderes.',en:'The test date / validity start is missing, so validity cannot be assessed.'})}
  else{
    if(end&&now>end){blocking=true;A.push({lvl:'bad',t:`Certifikatet udløb ${fmt(end)}.`,en:`The certificate expired on ${iso(end)}.`})}
    else if(end&&days(now,end)<60)A.push({lvl:'warn',t:`Certifikatet udløber om ${days(now,end)} dage (${fmt(end)}).`,en:`The certificate expires in ${days(now,end)} days (${iso(end)}).`});
    gaps.forEach(g=>{blocking=true;A.push({lvl:'bad',t:`6-måneders bekræftelse mangler: efter ${fmt(g.from)} skulle der være underskrevet senest ${fmt(g.due)}, men næste underskrift er først ${fmt(g.to)}. Kvalifikationen bortfaldt ${fmt(g.due)}.`,en:`Missing 6-month confirmation: after ${iso(g.from)} it had to be signed by ${iso(g.due)}, but the next signature is dated ${iso(g.to)}. The qualification lapsed on ${iso(g.due)}.`})});
    if(now>nextDue){blocking=true;A.push({lvl:'bad',t:`6-måneders bekræftelsen efter §9.2 skulle have været underskrevet senest ${fmt(nextDue)}${sig.last?` (seneste underskrift ${fmt(sig.last)})`:' (ingen underskrifter)'}.`,en:`The 6-month confirmation per clause 9.2 was due by ${iso(nextDue)}${sig.last?` (last signature ${iso(sig.last)})`:' (no signatures)'}.`})}
    else if(!gaps.length){const dl=days(now,nextDue);A.push({lvl:dl<30?'warn':'ok',t:`Næste 6-måneders bekræftelse skal underskrives senest ${fmt(nextDue)}${dl<30?` (om ${dl} dage)`:''}.`,en:`The next 6-month confirmation must be signed by ${iso(nextDue)}.`})}
    if(unread)A.push({lvl:'warn',t:`${unread} underskrift${unread>1?'er':''} har en dato, der ikke kunne læses. Kontrollér dem på certifikatet.`,en:`${unread} signature${unread>1?'s have':' has'} an unreadable date. Check on the certificate.`});
    if(to&&f.method){const lim=f.method==='a'?36:f.method==='b'?24:null;if(lim&&to>addM(start,lim))A.push({lvl:'bad',fraud:true,t:`"Gyldig til" er længere end §9.3 ${f.method}) tillader (højst ${lim/12} år fra ${fmt(start)}).`,en:`"Valid until" exceeds what clause 9.3 ${f.method}) allows (max. ${lim/12} years from ${iso(start)}).`})}
    if(to&&to<start)A.push({lvl:'bad',fraud:true,t:'"Gyldig til" ligger før prøvedatoen.',en:'"Valid until" is before the test date.'});
    if(iss&&iss<start)A.push({lvl:'bad',fraud:true,t:'Certifikatet er udstedt før prøvedatoen.',en:'The certificate is issued before the test date.'});
  }
  if(iss&&iss>now)A.push({lvl:'bad',fraud:true,t:'Udstedelsesdatoen ligger i fremtiden.',en:'The issue date is in the future.'});
  it.conf.forEach(c=>{const d=D(c.date);if(d&&d>now)A.push({lvl:'bad',fraud:true,t:`En 6-måneders underskrift er dateret i fremtiden (${fmt(d)}).`,en:`A 6-month signature is dated in the future (${iso(d)}).`})});
  const c=cnpCheck(f.idNo);
  if(c){if(!c.valid)A.push({lvl:'bad',fraud:true,t:'Det rumænske personnummer (CNP) har forkert kontrolciffer.',en:'The Romanian personal number (CNP) has an invalid check digit.'});
    else if(f.dob&&f.dob!==c.dob)A.push({lvl:'bad',fraud:true,t:`Personnummeret (CNP) passer til fødselsdato ${fmt(c.dob)}, ikke den angivne.`,en:`The personal number (CNP) matches date of birth ${c.dob}, not the one stated.`});
    else A.push({lvl:'ok',t:'Personnummeret (CNP) er gyldigt og passer med fødselsdatoen.',en:'The personal number (CNP) is valid and matches the date of birth.'})}
  if(f.name&&f.employer&&norm(f.name).split('').sort().join('')===norm(f.employer).split('').sort().join(''))A.push({lvl:'warn',fraud:true,t:'Arbejdsgiveren er svejserens eget navn. Det kan være korrekt for selvstændige, men skal bekræftes af udstederen.',en:"The employer is the welder's own name. This may be correct for a self-employed welder but must be confirmed by the issuer."});
  if(f.restrictions)A.push({lvl:'warn',t:`Begrænsning: ${f.restrictions}`,en:`Restriction: ${f.restrictions}`});
  it.metaFlags.forEach(m=>A.push(m));
  it.ai.anomalies.forEach(a=>A.push({lvl:'warn',fraud:true,t:`AI-bemærkning: ${a}`,en:`AI observation: ${a}`}));
  CHECKS.filter(g=>g.flag).flatMap(g=>g.items).forEach(([id,t])=>{if(it.c[id])A.push({lvl:'bad',fraud:true,t:`Observeret: ${t}.`,en:`Observed: ${EN_FLAG[id]}.`})});
  crossAlerts(it).forEach(a=>A.push(a));
  const fraud=A.filter(a=>a.fraud&&a.lvl!=='ok');
  const req=CHECKS.filter(g=>!g.flag).flatMap(g=>g.items.map(i=>i[0]));const done=req.filter(id=>it.c[id]).length;
  let cls,big,en,sub='';
  if(it.cf.no){cls='bad';big='Afvist af udsteder';en='Rejected by the issuer'}
  else if(fraud.length&&!it.cf.ok){cls='bad';big='Mulig forfalskning';en='Possibly forged or altered'}
  else if(!start){cls='warn';big='Mangler data';en='Insufficient data'}
  else if(blocking){cls='bad';big='Ikke gyldigt';en='Not valid'}
  else{cls='ok';big=it.cf.ok?'Gyldigt, bekræftet':'Gyldigt';en=it.cf.ok?'Valid, confirmed by the issuer':'Valid'}
  if(it.ai.status==='running')sub='Aflæses med AI …';else if(it.ai.status==='queued')sub='Venter på AI …';else if(it.ai.status==='error')sub='AI-fejl';
  else if(cls!=='bad'||big==='Ikke gyldigt')sub=`Tjekliste ${done}/${req.length}`;
  return{A,cls,big,en,sub,sig,fraud,done,req:req.length};
}
const iso=d=>d?new Date(d.getTime()-d.getTimezoneOffset()*6e4).toISOString().slice(0,10):'';
const EN_FLAG={f1:'a field has a different font, size or position',f2:'remains of erased text, white patches or smudges',f3:'a stamp, seal or signature appears copied or pasted',f4:'the 6-month signatures look identical or made at the same time'};

/* ================= statement ================= */
function statement(it,lang){
