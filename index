<script>
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function toast(t){const e=$('toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',3500)}

/* ================= indstillinger ================= */
const SET_KEY='verif9606.settings';
let SET=Object.assign({checker:'',company:'',key:'',model:'claude-sonnet-5',auto:true},JSON.parse(localStorage.getItem(SET_KEY)||'{}'));
function saveSet(){try{localStorage.setItem(SET_KEY,JSON.stringify(SET))}catch(e){}showAi()}
function showAi(){$('aiState').textContent=SET.key?'AI-aflæsning slået til':'AI-aflæsning ikke sat op'}
$('btnSettings').onclick=()=>{$('setChecker').value=SET.checker;$('setCompany').value=SET.company;$('setKey').value=SET.key;$('setModel').value=SET.model;$('setAuto').checked=SET.auto;$('dlgSet').showModal()};
$('btnSetOk').onclick=()=>{SET.checker=$('setChecker').value.trim();SET.company=$('setCompany').value.trim();SET.key=$('setKey').value.trim();SET.model=$('setModel').value.trim()||'claude-sonnet-5';SET.auto=$('setAuto').checked;saveSet();$('dlgSet').close();renderList()};
$('btnWipe').onclick=async()=>{if(!confirm('Slet alle certifikater og resultater i listen? Det kan ikke fortrydes.'))return;await dbClear();ITEMS=[];$('dlgSet').close();renderList()};

/* ================= IndexedDB ================= */
let DB;
function dbOpen(){return new Promise((res,rej)=>{const r=indexedDB.open('verif9606',1);r.onupgradeneeded=()=>{const d=r.result;d.createObjectStore('items',{keyPath:'id'});d.createObjectStore('blobs')};r.onsuccess=()=>{DB=r.result;res()};r.onerror=()=>rej(r.error)})}
const tx=(s,m='readonly')=>DB.transaction(s,m).objectStore(s);
const pr=r=>new Promise((res,rej)=>{r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)});
const dbAll=()=>pr(tx('items').getAll());
const dbPut=it=>pr(tx('items','readwrite').put(it));
const dbDel=id=>Promise.all([pr(tx('items','readwrite').delete(id)),pr(tx('blobs','readwrite').delete(id))]);
const dbBlobPut=(id,b)=>pr(tx('blobs','readwrite').put(b,id));
const dbBlob=id=>pr(tx('blobs').get(id));
async function dbClear(){await pr(tx('items','readwrite').clear());await pr(tx('blobs','readwrite').clear())}
const saveT={};function save(it){clearTimeout(saveT[it.id]);saveT[it.id]=setTimeout(()=>dbPut(it).catch(e=>toast('Kunne ikke gemme i browseren: '+e.message)),300)}

/* ================= definitioner ================= */
const FIELDS=[
 ['issuer','Udsteder (prøvningsorgan)'],['issuerEmail','Udsteders e-mail'],
 ['certNo','Certifikat-nr.'],['fileNo','Sags-/filnr.'],
 ['name','Svejserens navn'],['employer','Arbejdsgiver'],
 ['dob','Fødselsdato','date'],['idNo','ID-/personnummer'],
 ['standard','Standard'],['designation','Betegnelse (symbolisering)'],
 ['testDate','Prøvedato / gyldig fra','date'],['issueDate','Udstedt (eksaminatorens dato)','date'],
 ['method','Forlængelse efter §9.3','select'],['validTo','Gyldig til','date'],
 ['examiner','Eksaminator'],['restrictions','Begrænsninger i anvendelse'],
 ['verifyUrl','QR-kode eller verifikationslink','text','full']
];
const CHECKS=[
 {g:'Dokument og udsteder',items:[['d1','Udstederen er identificeret med navn og kontaktoplysninger'],['d2','Certifikat-nr. er ens på alle sider'],['d3','Alle sider er med'],['d4','Eksaminatorens navn, dato og underskrift er til stede'],['d5','Udstederens stempel eller segl er til stede']]},
 {g:'Svejseren',items:[['w1','Foto, navn og fødselsdato er angivet'],['w2','Identifikationsmetoden er angivet'],['w3','Svejseren har vist gyldigt ID, og det passer med certifikatet'],['w4','Arbejdsgiveren passer med dem, der sendte certifikatet']]},
 {g:'Prøvning og kvalifikation',items:[['q1','Betegnelsen stemmer med prøvedetaljerne'],['q2','Gyldighedsområdet følger reglerne i ISO 9606-1'],['q3','Prøvningen er udført og accepteret som krævet i afsnit 6.4'],['q4','Prøverapporterne har nummer og dato'],['q5','Gyldighedsområdet og eventuelle begrænsninger dækker opgaven']]},
 {g:'Tegn på forfalskning',flag:true,items:[['f1','Forskellig skrifttype, størrelse eller placering i et felt'],['f2','Rester af slettet tekst, hvide felter eller pletter'],['f3','Stempel, segl eller underskrift ser kopieret eller indsat ud'],['f4','Underskrifterne for 6-måneders bekræftelse ser ens ud eller er lavet på én gang']]}
];
const EDIT_TOOLS=/ilovepdf|smallpdf|sejda|pdf24|pdfescape|pdffiller|photoshop|gimp|canva|pixlr|paint|affinity|inkscape|pdfelement|docfly|lightpdf|sodapdf|pdfcandy|pdf candy|microsoft word|libreoffice|openoffice|nitro/i;
const SCANNERS=/ricoh|canon|xerox|konica|minolta|kyocera|sharp|brother|epson|toshiba|lexmark|hewlett|\bhp\b|océ|olivetti|develop|scan/i;
const PHONE_W=[720,750,828,1080,1125,1170,1179,1206,1242,1284,1290,1320,1440];

/* ================= datoer ================= */
const today=()=>new Date().toISOString().slice(0,10);
const D=s=>s&&/^\d{4}-\d{2}-\d{2}$/.test(s)?new Date(s+'T00:00:00'):null;
const addM=(d,m)=>{const x=new Date(d);const day=x.getDate();x.setMonth(x.getMonth()+m);if(x.getDate()<day)x.setDate(0);return x};
const fmt=d=>{if(typeof d==='string')d=D(d);return d?d.toLocaleDateString('da-DK',{day:'2-digit',month:'2-digit',year:'numeric'}):''};
const days=(a,b)=>Math.round((b-a)/864e5);
const normDate=s=>{if(!s)return'';s=String(s).trim();if(/^\d{4}-\d{2}-\d{2}$/.test(s))return s;const m=s.match(/^(\d{1,2})[.\/-](\d{1,2})[.\/-](\d{4})$/);return m?`${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`:''};
const norm=s=>(s||'').toLowerCase().replace(/[^a-z0-9æøåäöüșțăâîéèç]/g,'');

/* ================= rumænsk CNP ================= */
function cnpCheck(v){v=(v||'').replace(/\s/g,'');if(!/^[1-8]\d{12}$/.test(v))return null;const k='279146358279';let s=0;for(let i=0;i<12;i++)s+=+v[i]*+k[i];let c=s%11;if(c===10)c=1;const cent={1:1900,2:1900,3:1800,4:1800,5:2000,6:2000,7:1900,8:1900}[v[0]];return{valid:c===+v[12],dob:`${cent+ +v.slice(1,3)}-${v.slice(3,5)}-${v.slice(5,7)}`}}

/* ================= state ================= */
let ITEMS=[];let FILTER='all';const OPEN=new Set();
function newItem(file,hash){return{id:'c'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),added:new Date().toISOString(),file:{name:file.name,size:file.size,type:file.type,hash},thumb:'',pages:0,meta:null,images:[],hasText:false,metaFlags:[],f:{},conf:[],reval:[],c:{},cf:{ok:false,no:false,date:'',by:''},notes:'',ai:{status:'none',anomalies:[],error:''},cmp:{},lang:'da'}}

/* ================= PDF/billede ================= */
const docCache=new Map();
async function getDoc(id){
  if(docCache.has(id))return docCache.get(id);
  const blob=await dbBlob(id);if(!blob)throw new Error('Filen findes ikke længere i browseren.');
  let d;
  if(blob.type==='application/pdf'||(!blob.type.startsWith('image/'))){d={pdf:await pdfjsLib.getDocument({data:new Uint8Array(await blob.arrayBuffer())}).promise}}
  else{const url=URL.createObjectURL(blob);d={img:await new Promise((r,j)=>{const i=new Image();i.onload=()=>r(i);i.onerror=j;i.src=url})}}
  d.n=d.pdf?d.pdf.numPages:1;
  docCache.set(id,d);if(docCache.size>6){const k=docCache.keys().next().value;const o=docCache.get(k);if(o.pdf)o.pdf.destroy();docCache.delete(k)}
  return d;
}
async function renderPage(id,p,width){
  const d=await getDoc(id);const c=document.createElement('canvas');
  if(d.pdf){const page=await d.pdf.getPage(p);const v1=page.getViewport({scale:1});const vp=page.getViewport({scale:width/v1.width});c.width=Math.round(vp.width);c.height=Math.round(vp.height);const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);await page.render({canvasContext:x,viewport:vp}).promise}
  else{c.width=width;c.height=Math.round(d.img.height*width/d.img.width);const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(d.img,0,0,c.width,c.height)}
  return c;
}
async function inspect(it){
  const d=await getDoc(it.id);it.pages=d.n;it.images=[];
  if(d.pdf){
    try{it.meta=(await d.pdf.getMetadata()).info||null}catch(e){}
    for(let p=1;p<=d.n;p++){
      const page=await d.pdf.getPage(p);const v1=page.getViewport({scale:1});
      try{const tc=await page.getTextContent();if(tc.items.some(i=>i.str.trim()))it.hasText=true}catch(e){}
      try{const ops=await page.getOperatorList();for(let i=0;i<ops.fnArray.length;i++){if(ops.fnArray[i]===pdfjsLib.OPS.paintImageXObject||ops.fnArray[i]===pdfjsLib.OPS.paintJpegXObject){const oid=ops.argsArray[i][0];const st=oid.startsWith('g_')?page.commonObjs:page.objs;const img=await new Promise(r=>{try{st.get(oid,r)}catch(e){r(null)}});if(img&&img.width)it.images.push({w:img.width,h:img.height,ppi:Math.round(Math.max(img.width,img.height)/(Math.max(v1.width,v1.height)/72)),page:p})}}}catch(e){}
    }
