.head{display:grid;grid-template-columns:54px minmax(0,2.2fr) minmax(0,1.4fr) 110px 130px 170px 24px;gap:12px;align-items:center;padding:8px 12px;width:100%;text-align:left;background:none;border:none;color:inherit}
