  let rec;
  if(v.cls==='bad'&&(v.big==='Mulig forfalskning'))rec=L(`Kontakt ${esc(f.issuer||'udstederen')} og få bekræftet certifikatets ægthed og indhold, især arbejdsgiveren. Brug kontaktoplysninger fra udstederens officielle hjemmeside. Svejseren må ikke svejse på certifikatet, før det er bekræftet.`,`Contact ${esc(f.issuer||'the issuer')} to confirm the authenticity and content of the certificate, in particular the employer. Use contact details from the issuer's official website. The welder must not weld under this certificate until it is confirmed.`);
  else if(v.big==='Ikke gyldigt')rec=L('Svejseren skal have certifikatet forlænget eller tage en ny prøve, før der svejses på det.','The welder must have the certificate revalidated or take a new test before welding under it.');
  else if(v.cls==='ok')rec=L(`Næste 6-måneders bekræftelse skal underskrives senest ${fmt(s.nextDue)}. Kontrollér at gyldighedsområdet dækker opgaven.`,`The next 6-month confirmation must be signed by ${iso(s.nextDue)}. Check that the range of qualification covers the work.`);
  else rec=L('Udfyld de manglende oplysninger, eller aflæs certifikatet med AI.','Complete the missing information or read the certificate with AI.');
  const by=[SET.checker,SET.company].filter(Boolean).join(', ');
  return{cls:v.cls,html:`<h4>${L('Statement: kontrol af svejsercertifikat','Statement: welder certificate verification')}</h4>
