  else if(tool&&SCANNERS.test(tool))F.push({lvl:'ok',t:`Filen er scannet på ${tool}${cd?' den '+cd.toLocaleDateString('da-DK'):''}.`,en:`The file was scanned on ${tool}${cd?' on '+cd.toISOString().slice(0,10):''}.`});
  if(cd&&md&&Math.abs(md-cd)>6e4)F.push({lvl:'warn',t:`Filen er ændret ${md.toLocaleDateString('da-DK')}, efter den blev oprettet ${cd.toLocaleDateString('da-DK')}.`,en:`The file was modified on ${md.toISOString().slice(0,10)} after it was created on ${cd.toISOString().slice(0,10)}.`});
