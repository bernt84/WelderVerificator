async function sha256(buf){const h=await crypto.subtle.digest('SHA-256',buf);return[...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join('')}
function addFiles(files){files.filter(f=>f.type==='application/pdf'||/\.pdf$/i.test(f.name)||f.type.startsWith('image/')).forEach(f=>Q.push(f));runQ()}
async function runQ(){
  if(qBusy)return;qBusy=true;
  while(Q.length){
    const f=Q.shift();$('queue').textContent=`Indlæser ${f.name} (${Q.length} i kø) …`;
    try{
      const buf=await f.arrayBuffer();const hash=await sha256(buf);
      const dup=ITEMS.find(x=>x.file.hash===hash);
      if(dup){toast(`${f.name} er allerede i listen (samme fil som ${dup.file.name}).`);continue}
      const it=newItem(f,hash);
      await dbBlobPut(it.id,new Blob([buf],{type:f.type||(/\.pdf$/i.test(f.name)?'application/pdf':'')}));
      await inspect(it);ITEMS.unshift(it);await dbPut(it);renderList();
      if(SET.key&&SET.auto)aiQueue(it.id);
    }catch(e){console.error(e);toast(`${f.name} kunne ikke læses: ${e.message||e}`)}
  }
  $('queue').textContent='';qBusy=false;
}

