    ok:L(`Konklusion: Certifikatet er gyldigt i dag${it.cf.ok?' og bekræftet af udstederen':''}.`,`Conclusion: The certificate is valid today${it.cf.ok?' and confirmed by the issuer':''}.`),
    warn:L('Konklusion: Der mangler oplysninger til at vurdere certifikatet.','Conclusion: Information is missing to assess the certificate.')};
  const concl=v.cls==='bad'?conclTxt.bad[v.big]:conclTxt[v.cls];
