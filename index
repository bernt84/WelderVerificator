  qa('[data-lang]').forEach(b=>b.onclick=()=>{it.lang=b.dataset.lang;save(it);qa('[data-lang]').forEach(x=>x.classList.toggle('on',x===b));refresh(it)});
  q('[data-copy]').onclick=async()=>{const t=q('[data-stmt]').innerText;try{await navigator.clipboard.writeText(t);toast('Statement kopieret.')}catch(e){toast('Kunne ikke kopiere. Markér teksten og kopiér manuelt.')}};
  q('[data-print]').onclick=()=>printStatements([it]);
  q('[data-ai]').onclick=()=>{if(it.ai.status==='done'&&!confirm('Aflæs igen? Tomme felter udfyldes, felter du har rettet, bevares.'))return;aiQueue(it.id)};
  q('[data-cmpgo]').onclick=async()=>{const o=ITEMS.find(x=>x.id===q('[data-cmpsel]').value);if(!o)return;q('[data-crops]').innerHTML='<p class="hint">Sammenligner …</p>';await new Promise(r=>setTimeout(r,20));try{await compare(it,o)}catch(e){toast('Sammenligningen fejlede: '+e.message)}renderList()};
  q('[data-mail]').onclick=()=>mailIssuer(it);
  q('[data-search]').onclick=()=>window.open('https://www.google.com/search?q='+encodeURIComponent(`${it.f.issuer||''} welder qualification certificate verification`),'_blank','noopener');
  q('[data-url]').onclick=()=>{const u=(it.f.verifyUrl||'').trim();if(!/^https?:\/\//i.test(u)){toast('Indtast linket fra certifikatets QR-kode i feltet "QR-kode eller verifikationslink".');return}if(confirm('Åbn '+u+'?\n\nTjek at domænet tilhører udstederen. Falske certifikater kan have falske links.'))window.open(u,'_blank','noopener')};
  q('[data-delete]').onclick=async()=>{if(!confirm('Fjern certifikatet fra listen?'))return;await dbDel(it.id);docCache.delete(it.id);ITEMS=ITEMS.filter(x=>x!==it);ITEMS.forEach(o=>{if(o.cmp[it.id]){delete o.cmp[it.id];save(o)}});OPEN.delete(it.id);renderList()};
  return d;
}
function mailIssuer(it){
  const f=it.f;const conf=it.conf.map(c=>`  ${c.date||'?'} ${c.name||''} ${c.title||''}`).join('\n');
  const body=`Dear ${f.issuer||'Sir/Madam'},

We have received the welder qualification certificate below and kindly ask you to confirm that it was issued by you and that the content is unchanged.

Certificate no.: ${f.certNo||''}
File no.: ${f.fileNo||''}
Welder: ${f.name||''}
Date of birth: ${f.dob||''}
Employer stated on the certificate: ${f.employer||''}
Designation: ${f.designation||''}
Validity from: ${f.testDate||''}
Valid until: ${f.validTo||''}
Examiner / date: ${f.examiner||''} ${f.issueDate||''}
${conf?'6-month confirmations on the copy we received:\n'+conf+'\n':''}
Please confirm in particular which employer is stated on the original certificate. A copy of the certificate we received is attached.

Kind regards
${[SET.checker,SET.company].filter(Boolean).join('\n')}`;
  location.href=`mailto:${encodeURIComponent(f.issuerEmail||'')}?subject=${encodeURIComponent('Verification request – welder certificate '+(f.certNo||''))}&body=${encodeURIComponent(body)}`;
}

/* ================= udskrift og eksport ================= */
function printStatements(list){
  if(!list.length){toast('Der er ingen certifikater at udskrive.');return}
  $('printArea').innerHTML=list.map(it=>`<div class="stmt">${statement(it,it.lang).html}</div>`).join('');
  setTimeout(()=>window.print(),60);
}
$('btnPrintAll').onclick=()=>{const q=norm($('q').value);printStatements(ITEMS.filter(it=>{const v=evaluate(it);const isF=v.big==='Mulig forfalskning'||v.big==='Afvist af udsteder';
  if(q&&!norm([it.f.name,it.f.certNo,it.f.employer,it.f.issuer,it.file.name].join(' ')).includes(q))return false;
  return FILTER==='all'||(FILTER==='fraud'&&isF)||(FILTER==='bad'&&v.cls==='bad'&&!isF)||(FILTER==='ok'&&v.cls==='ok')||(FILTER==='warn'&&v.cls==='warn')}))};
$('btnCsv').onclick=()=>{
  const cols=['Resultat','Svejser','Fødselsdato','Cert.-nr.','Udsteder','Arbejdsgiver','Betegnelse','Gyldig fra','Gyldig til','Seneste underskrift','Næste underskrift senest','Antal underskrifter','Fund','Fil'];
  const q=s=>`"${String(s??'').replace(/"/g,'""')}"`;
  const lines=ITEMS.map(it=>{const v=evaluate(it),s=v.sig;return[v.big,it.f.name,it.f.dob,it.f.certNo,it.f.issuer,it.f.employer,it.f.designation,it.f.testDate,s.end?iso(s.end):'',s.last?iso(s.last):'',s.nextDue?iso(s.nextDue):'',it.conf.length,v.A.filter(a=>a.lvl!=='ok').map(a=>a.t).join(' | '),it.file.name].map(q).join(';')});
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+[cols.map(q).join(';'),...lines].join('\r\n')],{type:'text/csv'}));a.download=`svejsercertifikater-${today()}.csv`;a.click();
};
$('btnBackup').onclick=async()=>{
  toast('Laver backup …');const out=[];
  for(const it of ITEMS){const b=await dbBlob(it.id);const data=b?await new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result);fr.readAsDataURL(b)}):null;out.push({item:it,file:data})}
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({app:'verif9606',v:2,at:new Date().toISOString(),items:out})],{type:'application/json'}));a.download=`verifikator-backup-${today()}.json`;a.click();
};
$('btnRestore').onclick=()=>$('fileRestore').click();
$('fileRestore').onchange=async e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  try{const j=JSON.parse(await f.text());if(j.app!=='verif9606'||!Array.isArray(j.items))throw new Error('ukendt format');let n=0;
    for(const {item,file} of j.items){if(!item||!item.id||ITEMS.some(x=>x.id===item.id||x.file.hash===item.file.hash))continue;if(file){const b=await (await fetch(file)).blob();await dbBlobPut(item.id,b)}await dbPut(item);ITEMS.push(item);n++}
    renderList();toast(`${n} certifikater gendannet. Eksisterende er bevaret.`)}catch(err){toast('Filen kunne ikke gendannes: '+err.message)}
};

/* ================= start ================= */
(async()=>{
  showAi();
  try{await dbOpen();ITEMS=(await dbAll()).sort((a,b)=>b.added.localeCompare(a.added))}catch(e){toast('Browseren tillader ikke lokal lagring. Listen gemmes ikke.')}
  ITEMS.forEach(it=>{it.cmp=it.cmp||{};it.conf=it.conf||[];it.reval=it.reval||[];it.ai=it.ai||{status:'none',anomalies:[]};it.ai.anomalies=it.ai.anomalies||[];if(it.ai.status==='running'||it.ai.status==='queued')it.ai.status='none'});
  renderList();
})();
</script>
</body>
