<style>
:root{--bg:#12140f;--bg2:#1a1d16;--bg3:#232719;--line:#3a4130;--ink:#e8ecdf;--dim:#98a189;--teal:#2fb3a3;--lime:#c6f24e;--ok:#57c98a;--bad:#ff6b5e;--warn:#f5b942;--r:6px;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:Archivo,system-ui,sans-serif;font-size:15px;line-height:1.45}
input,select,textarea,.mono{font-family:'Space Mono',ui-monospace,monospace}
a{color:var(--teal)} button{font:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--lime);outline-offset:2px}
header{background:var(--bg2);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
.hw{max-width:1400px;margin:0 auto;padding:10px 16px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.logo{font-weight:800;font-size:18px;letter-spacing:-.02em}.logo b{color:var(--lime)}
.hw .sp{margin-left:auto}
main{max-width:1400px;margin:0 auto;padding:16px}
.hint{color:var(--dim);font-size:13px}
.btn{background:var(--bg);border:1px solid var(--line);color:var(--ink);padding:7px 12px;border-radius:4px;font-size:13px}
.btn.pri{background:var(--lime);border-color:var(--lime);color:#15180f;font-weight:600}
.btn.sm{padding:4px 8px;font-size:12px}
.btn.del{color:var(--bad)}
.btn:disabled{opacity:.5;cursor:default}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
input,select,textarea{background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:4px;padding:7px 8px;font-size:13px;width:100%}

.drop{border:2px dashed var(--line);border-radius:var(--r);padding:28px 16px;text-align:center;color:var(--dim);cursor:pointer;background:var(--bg2)}
