function pdfDate(s){if(!s)return null;const m=String(s).match(/D:(\d{4})(\d{2})?(\d{2})?(\d{2})?(\d{2})?/);return m?new Date(Date.UTC(+m[1],(+m[2]||1)-1,+m[3]||1,+m[4]||0,+m[5]||0)):null}
