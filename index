  const conf=it.conf.length?L(`6-måneders bekræftelser (§9.2): ${it.conf.map(c=>`${c.date?fmt(c.date):'ulæselig dato'}${c.name?' '+esc(c.name):''}`).join(', ')}.`,`6-month confirmations (clause 9.2): ${it.conf.map(c=>`${c.date||'unreadable date'}${c.name?' '+esc(c.name):''}`).join(', ')}.`):L('Ingen 6-måneders bekræftelser er underskrevet.','No 6-month confirmations have been signed.');
