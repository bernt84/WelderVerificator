.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:16px 0 10px}
.tools input[type=search]{max-width:280px}
.tools select{width:auto}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font-size:12px;border:1px solid var(--line);border-radius:20px;padding:3px 10px;background:none;color:var(--dim)}
.chip.on{color:var(--ink);border-color:var(--ink)}
